# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit file .env ke GitHub.

# Connection string dari Neon (Dashboard > Connect). Pakai yang "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Kunci rahasia untuk menandatangani token sesi login (akun pengguna).
# WAJIB diisi dengan string acak yang panjang & rahasia di produksi.
# Contoh membuatnya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"
